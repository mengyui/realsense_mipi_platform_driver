/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/tegra264-gpio.h>

#define STR_HELPER(x)         #x
#define STR(x)                STR_HELPER(x)

// // I2C-9
// #define DES0_I2C_BUS_NAME     "9"
// #define DES0_I2C_BUS          i2c@810c6a0000
// #define DES0_PORT_INDEX       2
// #define DES0_TEGRA_SINTERFACE "serial_c"
// I2C-12
#define DES0_I2C_BUS_NAME     "12"
#define DES0_I2C_BUS          i2c@810c6d0000
#define DES0_PORT_INDEX       0
#define DES0_TEGRA_SINTERFACE "serial_a"

#define DES0_MIPI_LANES       4
#define DES0_MIPI_LANES_STR   STR(DES0_MIPI_LANES)

#define SER_MIPI_LANES        2
#define SER_MIPI_LANES_STR    STR(SER_MIPI_LANES)

// 2Gbps, 125000000 pixel/s, clock 250MHz (4 lanes), 500MHz (2 lanes), 1GHz (1 lane)
// 3Gbps, 187500000 pixel/s, clock 375MHz (4 lanes), 750MHz (2 lanes), 1.5GHz (1 lane)
// 4Gbps, 250000000 pixel/s, clock 500MHz (4 lanes), 1GHz (2 lanes), 2GHz (1 lane)
// 6Gbps, 375000000 pixel/s, clock 750MHz (4 lanes), 1.5GHz (2 lanes), 3GHz (1 lane)
#define SERDES_PIX_CLK_HZ     "187500000"

/* camera control gpio definitions */
/ {
	overlay-name = "Thor I2C-12 FG12-4CH D457S";
	jetson-header-name = "Jetson 22pin CSI Connector";
	compatible = "nvidia,p4071-0000+p3834-0008", "nvidia,p3834-0008", "nvidia,tegra264";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			tegra-capture-vi {
				num-channels = <4>;
				ports {
					status = "okay";
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						status = "okay";
						reg = <0>;
						d4xx_vi_in0: endpoint {
							status = "okay";
							vc-id = <0>;
							port-index = <DES0_PORT_INDEX>;
							bus-width = <DES0_MIPI_LANES>;
							remote-endpoint = <&d4xx_csi_out0>;
						};
					};
					port@1 {
						status = "okay";
						reg = <1>;
						d4xx_vi_in1: endpoint {
							status = "okay";
							vc-id = <1>;
							port-index = <DES0_PORT_INDEX>;
							bus-width = <DES0_MIPI_LANES>;
							remote-endpoint = <&d4xx_csi_out1>;
						};
					};
					port@2 {
						status = "okay";
						reg = <2>;
						d4xx_vi_in2: endpoint {
							status = "okay";
							vc-id = <2>;
							port-index = <DES0_PORT_INDEX>;
							bus-width = <DES0_MIPI_LANES>;
							remote-endpoint = <&d4xx_csi_out2>;
						};
					};
					port@3 {
						status = "okay";
						reg = <3>;
						d4xx_vi_in3: endpoint {
							status = "okay";
							vc-id = <3>;
							port-index = <DES0_PORT_INDEX>;
							bus-width = <DES0_MIPI_LANES>;
							remote-endpoint = <&d4xx_csi_out3>;
						};
					};
				};
			};
			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				status = "okay";
				num_csi_lanes = <DES0_MIPI_LANES>;
				max_lane_speed = <1500000>;
				min_bits_per_pixel = <8>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				max_pixel_rate = <160000>;
				isp_peak_byte_per_pixel = <5>;
				isp_bw_margin_pct = <25>;
				modules {
					status = "okay";
					module0 {
						status = "okay";
						badge = "d4xx_depth";
						position = "left";
						orientation = "1";
						drivernode0 {
							status = "okay";
							pcl_id = "v4l2_sensor";
							devname = "DS5 mux 12-001a";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@810c6d0000/ds5@1a";
						};
					};
					module1 {
						status = "okay";
						badge = "d4xx_rgb";
						position = "left";
						orientation = "1";
						drivernode0 {
							status = "okay";
							pcl_id = "v4l2_sensor";
							devname = "DS5 mux 12-001b";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@810c6d0000/ds5@1b";
						};
					};
					module2 {
						status = "okay";
						badge = "d4xx_Y8";
						position = "left";
						orientation = "1";
						drivernode0 {
							status = "okay";
							pcl_id = "v4l2_sensor";
							devname = "DS5 mux 12-001c";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@810c6d0000/ds5@1c";
						};
					};
					module3 {
						status = "okay";
						badge = "d4xx_imu";
						position = "left";
						orientation = "1";
						drivernode0 {
							status = "okay";
							pcl_id = "v4l2_sensor";
							devname = "DS5 mux 12-001d";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@810c6d0000/ds5@1d";
						};
					};
				};
			};
			bus@0 {
				host1x@8181200000 {
					nvcsi@8188000000 {
						num-channels = <4>;
						channel@0 {
							status = "okay";
							reg = <0>;
							ports {
								status = "okay";
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									d4xx_csi_in0: endpoint@0 {
										status = "okay";
										port-index = <DES0_PORT_INDEX>;
										bus-width = <DES0_MIPI_LANES>;
										remote-endpoint = <&ds5_0_out>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									d4xx_csi_out0: endpoint@1 {
										status = "okay";
										remote-endpoint = <&d4xx_vi_in0>;
									};
								};
							};
						};
						channel@1 {
							status = "okay";
							reg = <1>;
							ports {
								status = "okay";
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									d4xx_csi_in1: endpoint@2 {
										status = "okay";
										port-index = <DES0_PORT_INDEX>;
										bus-width = <DES0_MIPI_LANES>;
										remote-endpoint = <&ds5_1_out>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									d4xx_csi_out1: endpoint@3 {
										status = "okay";
										remote-endpoint = <&d4xx_vi_in1>;
									};
								};
							};
						};
						channel@2 {
							status = "okay";
							reg = <2>;
							ports {
								status = "okay";
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									d4xx_csi_in2: endpoint@4 {
										status = "okay";
										port-index = <DES0_PORT_INDEX>;
										bus-width = <DES0_MIPI_LANES>;
										remote-endpoint = <&ds5_2_out>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									d4xx_csi_out2: endpoint@5 {
										status = "okay";
										remote-endpoint = <&d4xx_vi_in2>;
									};
								};
							};
						};
						channel@3 {
							status = "okay";
							reg = <3>;
							ports {
								status = "okay";
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									status = "okay";
									reg = <0>;
									d4xx_csi_in3: endpoint@6 {
										status = "okay";
										port-index = <DES0_PORT_INDEX>;
										bus-width = <DES0_MIPI_LANES>;
										remote-endpoint = <&ds5_3_out>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									d4xx_csi_out3: endpoint@7 {
										status = "okay";
										remote-endpoint = <&d4xx_vi_in3>;
									};
								};
							};
						};
					};
				};

				i2c@810c6d0000 {
					clock-frequency = <100000>;

					dser: max96712@29 {
						status = "okay";
						reg = <0x29>;
						compatible = "maxim,max96712";
						csi-mode = "2x4";
						link-mask = <0x1>;
						channel = "a";
						lane_cnt = <DES0_MIPI_LANES>;
						//force_clk0;
						fangzhu,fg12-reverse-lane-polarity;
						fangzhu,fg12-poc-enable;
						/* <serializer-vc deserializer-vc> */
						maxim,link0-vc-remap = <0 0>, <1 1>, <2 2>, <3 3>;
						// maxim,link1-vc-remap = <0 4>, <1 5>, <2 6>, <3 7>;
						// maxim,link2-vc-remap = <0 8>, <1 9>, <2 10>, <3 11>;
						// maxim,link3-vc-remap = <0 12>, <1 13>, <2 14>, <3 15>;
					};

					ser_a: max9295_a@40 {
						status = "okay";
						compatible = "maxim,max9295";
						reg = <0x40>;
						maxim,gmsl-dser-device = <&dser>;
					};

					ds5_3: ds5@1d {
						status = "okay";
						compatible = "intel,d4xx";
						reg = <0x1d>;
						def-addr = <0x10>;
						override_reg = <0x1a>;
						use_sensor_mode_id = "true";
						cam-type = "IMU";
						nvidia,gmsl-ser-device = <&ser_a>;
						nvidia,gmsl-dser-device = <&dser>;
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;
								ds5_3_out: endpoint {
									vc-id = <3>;
									port-index = <DES0_PORT_INDEX>;
									bus-width = <SER_MIPI_LANES>;
									remote-endpoint = <&d4xx_csi_in3>;
								};
							};
						};
						mode0 {
							pixel_t = "grey_y16";
							num_lanes = DES0_MIPI_LANES_STR;
							csi_pixel_bit_depth = "16";
							active_w = "640";
							active_h = "480";
							tegra_sinterface = DES0_TEGRA_SINTERFACE;
							mclk_khz = "24000";
							pix_clk_hz = "74250000";
							serdes_pix_clk_hz = SERDES_PIX_CLK_HZ;
							line_length = "640"; /* 2200 */
							embedded_metadata_height = "0";
						};
						gmsl-link {
							src-csi-port = "b";
							dst-csi-port = "a";
							serdes-csi-link = "a";
							csi-mode = "1x4";
							st-vc = <0>;
							vc-id = <3>;
							num-lanes = <SER_MIPI_LANES>;
						};
					};

					ds5_2: ds5@1c {
						status = "okay";
						compatible = "intel,d4xx";
						reg = <0x1c>;
						def-addr = <0x10>;
						override_reg = <0x1a>;
						use_sensor_mode_id = "true";
						cam-type = "Y8";
						nvidia,gmsl-ser-device = <&ser_a>;
						nvidia,gmsl-dser-device = <&dser>;
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;
								ds5_2_out: endpoint {
									vc-id = <2>;
									port-index = <DES0_PORT_INDEX>;
									bus-width = <SER_MIPI_LANES>;
									remote-endpoint = <&d4xx_csi_in2>;
								};
							};
						};
						/* mode0: Y8, mode1: depth D16 */
						mode0 {
							pixel_t = "grey_y16";
							num_lanes = DES0_MIPI_LANES_STR;
							csi_pixel_bit_depth = "16";
							active_w = "1280";
							active_h = "720";
							tegra_sinterface = DES0_TEGRA_SINTERFACE;
							mclk_khz = "24000";
							pix_clk_hz = "74250000";
							serdes_pix_clk_hz = SERDES_PIX_CLK_HZ;
							line_length = "1280"; /* 2200 */
							embedded_metadata_height = "1";
						};
						gmsl-link {
							src-csi-port = "b";
							dst-csi-port = "a";
							serdes-csi-link = "a";
							csi-mode = "1x4";
							st-vc = <0>;
							vc-id = <2>;
							num-lanes = <SER_MIPI_LANES>;
						};
					};

					ds5_1: ds5@1b {
						status = "okay";
						compatible = "intel,d4xx";
						reg = <0x1b>;
						def-addr = <0x10>;
						override_reg = <0x1a>;
						use_sensor_mode_id = "true";
						cam-type = "RGB";
						nvidia,gmsl-ser-device = <&ser_a>;
						nvidia,gmsl-dser-device = <&dser>;
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;
								ds5_1_out: endpoint {
									vc-id = <1>;
									port-index = <DES0_PORT_INDEX>;
									bus-width = <SER_MIPI_LANES>;
									remote-endpoint = <&d4xx_csi_in1>;
								};
							};
						};
						mode0 {
							pixel_t = "grey_y16";
							num_lanes = DES0_MIPI_LANES_STR;
							csi_pixel_bit_depth = "16";
							active_w = "1920";
							active_h = "1080";
							tegra_sinterface = DES0_TEGRA_SINTERFACE;
							mclk_khz = "24000";
							pix_clk_hz = "74250000";
							serdes_pix_clk_hz = SERDES_PIX_CLK_HZ;
							line_length = "1920"; /* 2200 */
							embedded_metadata_height = "1";
						};
						gmsl-link {
							src-csi-port = "b";
							dst-csi-port = "a";
							serdes-csi-link = "a";
							csi-mode = "1x4";
							st-vc = <0>;
							vc-id = <1>;
							num-lanes = <SER_MIPI_LANES>;
						};
					};

					ds5_0: ds5@1a {
						status = "okay";
						compatible = "intel,d4xx";
						reg = <0x1a>;
						def-addr = <0x10>;
						use_sensor_mode_id = "true";
						cam-type = "Depth";
						nvidia,gmsl-ser-device = <&ser_a>;
						nvidia,gmsl-dser-device = <&dser>;
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;
								ds5_0_out: endpoint {
									vc-id = <0>;
									port-index = <DES0_PORT_INDEX>;
									bus-width = <SER_MIPI_LANES>;
									remote-endpoint = <&d4xx_csi_in0>;
								};
							};
						};
						mode0 {
							pixel_t = "grey_y16";
							num_lanes = DES0_MIPI_LANES_STR;
							csi_pixel_bit_depth = "16";
							active_w = "1280";
							active_h = "720";
							tegra_sinterface = DES0_TEGRA_SINTERFACE;
							mclk_khz = "24000";
							pix_clk_hz = "74250000";
							serdes_pix_clk_hz = SERDES_PIX_CLK_HZ;
							line_length = "1280"; /* 2200 */
							embedded_metadata_height = "1";
						};
						gmsl-link {
							src-csi-port = "b";
							dst-csi-port = "a";
							serdes-csi-link = "a";
							csi-mode = "1x4";
							st-vc = <0>;
							vc-id = <0>;
							num-lanes = <SER_MIPI_LANES>;
						};
					};
				};
			};
		};
	};
};
